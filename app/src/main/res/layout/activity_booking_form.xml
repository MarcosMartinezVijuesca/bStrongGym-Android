<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <EditText
        android:id="@+id/et_bookingDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fecha de reserva (YYYY-MM-DD)"
        android:inputType="text"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_memberId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID del socio"
        android:inputType="number"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_activityId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID de la actividad"
        android:inputType="number"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_pricePaid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Precio pagado"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_reviewNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valoración (1-5)"
        android:inputType="number"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_reviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Comentario"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <CheckBox
        android:id="@+id/cb_attended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Asistió"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar"/>

</LinearLayout>