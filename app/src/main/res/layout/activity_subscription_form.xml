<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subscription_type"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rg_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rb_monthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONTHLY"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rb_quarterly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUARTERLY"/>

        <RadioButton
            android:id="@+id/rb_annual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANNUAL"/>

    </RadioGroup>

    <EditText
        android:id="@+id/et_startDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/start_date"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_endDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/end_date"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/price"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_memberId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/member_id"
        android:inputType="number"
        android:layout_marginBottom="12dp"/>

    <CheckBox
        android:id="@+id/cb_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/active_f"
        android:checked="true"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cb_autoRenewal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_renewal"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save"/>

</LinearLayout>